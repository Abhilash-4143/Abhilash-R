# Contact-form email setup (Resend + Vercel)
#
# Copy values into Vercel — NOT into this file. Do NOT commit real keys.
# Vercel path: Dashboard → your project "abhilash-r" → Settings →
#              Environment Variables → Add Variable (check Production,
#              Preview, Development) → Save → redeploy (Deployments → Redeploy).
#
# 1. Create a key at https://resend.com → API Keys (starts with re_).
RESEND_API_KEY=re_replace_with_your_key

# 2. Destination inbox (required, read server-side only).
CONTACT_EMAIL=ABHILASH.20241CSE0600@presidencyuniversity.in

# 3. Sender on a domain VERIFIED in Resend (required, no fallback).
#    Verify at resend.com/domains first, then use e.g.:
RESEND_FROM=Abhilash <hello@yourdomain.com>
#    Do NOT use onboarding@resend.dev for production delivery (Resend only
#    delivers that sender to your own Resend account email) and do NOT use
#    a Gmail or university address as the sender.
