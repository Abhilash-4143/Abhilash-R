# Copy to Vercel: Project → Settings → Environment Variables
# Do NOT commit real keys. Never put RESEND_API_KEY in frontend code.

# 1. Create a key at https://resend.com → API Keys
RESEND_API_KEY=re_your_resend_key

# 2. Destination inbox (already defaulted in code, but set explicitly)
CONTACT_EMAIL=ABHILASH.20241CSE0600@presidencyuniversity.in

# 3. Verified sender (optional). If you verify a domain in Resend, use e.g.
#    RESEND_FROM=Abhilash <hello@yourdomain.com>
#    Until then the code falls back to: Portfolio Contact <onboarding@resend.dev>
RESEND_FROM=Portfolio Contact <onboarding@resend.dev>
