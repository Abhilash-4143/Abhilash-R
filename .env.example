# EmailJS setup (portfolio contact form)
# EmailJS service/template/public key are PUBLIC identifiers, but keep this
# file values-free and add the real values only in Vercel:
# Vercel Dashboard → project "abhilash-r" → Settings → Environment Variables
# → Add Variable (check Production, Preview, Development) → Save → Redeploy.
VITE_EMAILJS_SERVICE_ID=service_replace_me
VITE_EMAILJS_TEMPLATE_ID=template_replace_me
VITE_EMAILJS_PUBLIC_KEY=public_replace_me
